{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich": ["FromLogContext"]
  },

  "AllowedHosts": "*",

  "ConnectionStrings": {
    "//": "Set by the host from a workload identity. Never a password (TAD 14.6.3).",
    "DocayaSql": ""
  },

  "Docaya": {
    "OperatingTimeZone": "Arabian Standard Time",

    "Entra": {
      "//": "Supplied per environment. Local development uses dotnet user-secrets.",
      "Authority": "",
      "Audience": ""
    },

    "Capture": {
      "//": "One file per registration, maximum 100 MB (TAD 7.1 step 1).",
      "MaxFileBytes": 104857600,
      "AllowedExtensions": ["pdf", "docx", "xlsx", "pptx", "png", "jpg", "jpeg", "tiff", "txt"]
    },

    "Sla": {
      "//": "Working-day targets, configurable per document type (TAD 8.3).",
      "UrgentWorkingDays": 12,
      "NormalWorkingDays": 30,
      "WarningWindowWorkingDays": 3
    },

    "FeatureFlags": {
      "//": "Ask answering is gated on POC outcomes so V1 can ship without it (TAD 6.3).",
      "AskAnsweringEnabled": false
    }
  }
}
