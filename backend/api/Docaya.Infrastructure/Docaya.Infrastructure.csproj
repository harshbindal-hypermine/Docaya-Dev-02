<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Docaya.Infrastructure - EF Core persistence and the SQL, Blob, Graph, Search,
    embedding, messaging and Power BI adapters.

    Technical Architecture Document v1.3, Section 17.2:
      May reference:        Docaya.Application (implements its ports) and provider SDKs.
      Must never reference: Docaya.Api.

    Provider SDKs appear ONLY in this project, behind an Application port. That is
    what makes the on-premises variant in Section 22 possible without rewriting
    business logic.
  -->

  <PropertyGroup>
    <RootNamespace>Docaya.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Docaya.Application\Docaya.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Persistence -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" />
  </ItemGroup>

  <ItemGroup>
    <!-- Azure adapters. All access is by workload identity; no keys in code (TAD 14.6). -->
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Azure.Storage.Blobs" />
    <PackageReference Include="Azure.Messaging.ServiceBus" />
    <PackageReference Include="Azure.Search.Documents" />
    <PackageReference Include="Azure.Security.KeyVault.Secrets" />
    <PackageReference Include="Microsoft.Graph" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MediatR" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>

</Project>
