<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Docaya.Domain - the innermost layer.

    Technical Architecture Document v1.3, Sections 6.1 and 17.2:
      "Docaya.Domain must compile with no reference to any Azure, Microsoft Graph,
       SharePoint, EF Core or messaging package."

    This project must contain NO ProjectReference and NO PackageReference.
    The rule is enforced mechanically by DomainPurityTests in Docaya.Tests,
    which fails the build if a provider package ever appears here.
  -->

  <PropertyGroup>
    <RootNamespace>Docaya.Domain</RootNamespace>
  </PropertyGroup>

</Project>
