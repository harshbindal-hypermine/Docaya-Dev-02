<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Docaya.Application - use cases, commands, queries, validators and ports.

    Technical Architecture Document v1.3, Section 17.2:
      May reference:        Docaya.Domain.
      Must never reference: any provider SDK - it defines ports, it does not
                            implement them.
  -->

  <PropertyGroup>
    <RootNamespace>Docaya.Application</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Docaya.Domain\Docaya.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Abstractions only. No Azure, Graph, EF Core or messaging package here. -->
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="MediatR.Contracts" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

</Project>
