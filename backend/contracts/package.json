{
  "name": "@docaya/contracts",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "description": "Docaya API contract: OpenAPI 3.1 document, domain event schemas and the client generation scripts. Authored before implementation so the UI and API cannot drift (TAD 17.3).",
  "engines": {
    "node": ">=22.13.0 <27",
    "npm": ">=10 <13"
  },
  "scripts": {
    "validate": "node scripts/validate-contracts.mjs",
    "gen:ts": "node scripts/generate-clients.mjs --target ts",
    "gen:cs": "node scripts/generate-clients.mjs --target cs",
    "gen": "node scripts/generate-clients.mjs --target all",
    "test": "npm run validate"
  },
  "devDependencies": {
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "openapi-typescript": "7.4.4",
    "yaml": "2.6.1"
  }
}
