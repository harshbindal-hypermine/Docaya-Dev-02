{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docaya.local/contracts/events/access-policy-changed.schema.json",
  "title": "AccessPolicyChanged",
  "description": "Raised when a policy version is published or attributes change. Consumers: index (aclKeys refresh), cache invalidation. Delivery: at-least-once.",
  "type": "object",
  "required": ["policyVersion", "changeKind", "changedByPrincipalId"],
  "additionalProperties": false,
  "properties": {
    "policyVersion": {
      "type": "string",
      "description": "Version logged with every authorization decision (TAD 24.1)."
    },
    "changeKind": {
      "type": "string",
      "enum": ["RoleAssignment", "AttributeChange", "PolicyPublished", "ScopeChange"]
    },
    "changedByPrincipalId": { "type": "string", "format": "uuid" },
    "affectedPrincipalIds": {
      "type": "array",
      "items": { "type": "string", "format": "uuid" }
    },
    "affectedDepartmentIds": {
      "type": "array",
      "items": { "type": "string", "format": "uuid" }
    },
    "requiresIndexRefresh": { "type": "boolean" }
  }
}
