{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docaya.local/contracts/events/sla-risk-changed.schema.json",
  "title": "SlaRiskChanged",
  "description": "Raised when the at-risk or overdue state changes. At risk is raised before the target date, not after it. Consumers: notification, analytics. Delivery: at-least-once.",
  "type": "object",
  "required": ["documentId", "approvalRequestId", "previousState", "currentState", "remainingWorkingDays"],
  "additionalProperties": false,
  "properties": {
    "documentId": { "type": "string", "format": "uuid" },
    "approvalRequestId": { "type": "string", "format": "uuid" },
    "previousState": { "type": "string", "enum": ["OnTrack", "AtRisk", "Overdue"] },
    "currentState": { "type": "string", "enum": ["OnTrack", "AtRisk", "Overdue"] },
    "remainingWorkingDays": { "type": "integer" },
    "currentTargetDate": { "type": "string", "format": "date" },
    "escalatedToPrincipalId": {
      "type": ["string", "null"],
      "format": "uuid",
      "description": "Set when a breach escalates to the configured delegate or manager."
    }
  }
}
