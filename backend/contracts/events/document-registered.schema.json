{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docaya.local/contracts/events/document-registered.schema.json",
  "title": "DocumentRegistered",
  "description": "Raised when the tracking number is issued and the registry row is created. Consumers: audit, notification. Delivery: at-least-once, idempotent.",
  "type": "object",
  "required": ["documentId", "trackingNumber", "registeredByPrincipalId"],
  "additionalProperties": false,
  "properties": {
    "documentId": { "type": "string", "format": "uuid" },
    "trackingNumber": { "type": "string", "pattern": "^DOC-\\d{4}-\\d{6}$" },
    "registeredByPrincipalId": { "type": "string", "format": "uuid" },
    "owningDepartmentId": { "type": ["string", "null"], "format": "uuid" },
    "sha256": {
      "type": ["string", "null"],
      "pattern": "^[a-f0-9]{64}$",
      "description": "Hash of the unchanged staged byte stream."
    },
    "sizeBytes": { "type": ["integer", "null"], "maximum": 104857600 }
  }
}
