{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docaya.local/contracts/events/review-decision-recorded.schema.json",
  "title": "ReviewDecisionRecorded",
  "description": "Raised when any stage approves or returns. Consumers: workflow, audit, analytics. Delivery: at-least-once.",
  "type": "object",
  "required": [
    "documentId",
    "approvalRequestId",
    "stageId",
    "stageOrdinal",
    "decision",
    "decidedByPrincipalId"
  ],
  "additionalProperties": false,
  "properties": {
    "documentId": { "type": "string", "format": "uuid" },
    "approvalRequestId": { "type": "string", "format": "uuid" },
    "stageId": { "type": "string", "format": "uuid" },
    "stageOrdinal": { "type": "integer", "minimum": 1 },
    "stageName": { "type": ["string", "null"] },
    "decision": { "type": "string", "enum": ["Approve", "Return"] },
    "decidedByPrincipalId": { "type": "string", "format": "uuid" },
    "correctionPoint": {
      "type": ["string", "null"],
      "enum": ["Editor", "PrecedingStage", null],
      "description": "Present when the decision is Return. A return is never a restart (TAD 8.4)."
    },
    "stageDurationWorkingDays": {
      "type": ["number", "null"],
      "description": "Captured automatically so delay is attributed to a specific stage."
    }
  }
}
